---
import { serviceCategories } from "../../config/service-categories";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  surface?: boolean;
}

const {
  eyebrow = "Browse services",
  title = "Handyman Services by Category in Adelaide",
  description = "Jump to the type of work you need, from general repairs and renovations to carpentry, outdoor maintenance, and rental or commercial support.",
  surface = true,
} = Astro.props;
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-20"]}>
  <Container>
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      alignment="center"
    />
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        serviceCategories.map((category) => (
          <a
            href={`#${category.id}`}
            class="rounded-[2px] border border-border bg-white p-5 transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-sm"
          >
            <h3 class="text-lg font-bold tracking-tight text-accent">
              {category.title}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground">
              {category.description}
            </p>
            <span class="mt-4 inline-flex font-heading text-sm font-semibold tracking-tight text-primary">
              Jump to list
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
