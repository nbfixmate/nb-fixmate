---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface MissionPoint {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  statement?: string;
  points?: MissionPoint[];
  ctaLabel?: string;
  ctaHref?: string;
  surface?: boolean;
}

const {
  eyebrow = "Our mission",
  title = "Keep Every Property in Great Condition",
  statement = "NB Fixmate exists to make handyman and property maintenance simple, reliable, and stress-free for Adelaide homes, rentals, and commercial spaces.",
  points = [
    {
      title: "Done properly",
      description: "Careful workmanship on every repair, renovation, and maintenance job.",
    },
    {
      title: "Done on time",
      description: "Clear communication and efficient delivery from quote through to completion.",
    },
    {
      title: "No job too small",
      description: "Everyday fixes and larger property work get the same practical attention.",
    },
  ],
  ctaLabel = "Request a free quote",
  ctaHref = "/contact",
  surface = false,
} = Astro.props;
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-24"]}>
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={statement}
        alignment="center"
        level="h2"
      />
    </div>

    <ul
      class="mx-auto mt-12 grid max-w-5xl gap-8 border-t border-border pt-10 sm:grid-cols-3 sm:gap-6"
      data-reveal-stagger
    >
      {
        points.map((point) => (
          <li class="text-center">
            <h3 class="text-lg font-bold tracking-tight text-accent">
              {point.title}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground sm:text-base">
              {point.description}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-center">
      <Button href={ctaHref} openQuote={ctaHref === "/contact"}>
        {ctaLabel}
      </Button>
    </div>
  </Container>
</section>
