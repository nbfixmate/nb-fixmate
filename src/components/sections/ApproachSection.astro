---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface ApproachPillar {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  pillars?: ApproachPillar[];
  surface?: boolean;
}

const {
  eyebrow = "Our approach",
  title = "How NB Fixmate Gets the Job Done",
  description = "Practical, fully insured handyman and property maintenance support across Adelaide and surrounding areas.",
  pillars = [
    {
      title: "Clear free quotes",
      description:
        "Share the work and your suburb, then get a free quote so you understand the job and cost before you book.",
    },
    {
      title: "Fully insured work",
      description:
        "NB Fixmate provides fully insured handyman and property maintenance services for residential and commercial properties.",
    },
    {
      title: "Practical fixes",
      description:
        "From everyday repairs and painting to carpentry, tiling, and broader renovations, we handle jobs of all sizes.",
    },
    {
      title: "Local Adelaide coverage",
      description:
        "Support for homeowners, landlords, property managers, and businesses across Adelaide and surrounding suburbs.",
    },
  ],
  surface = true,
} = Astro.props;
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-24"]}>
  <Container>
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      alignment="center"
      level="h2"
    />

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        pillars.map((pillar, index) => (
          <li class="flex flex-col items-center text-center sm:items-start sm:text-left">
            <span
              class="font-heading text-sm font-bold tracking-tight text-primary"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 text-lg font-bold tracking-tight text-accent">
              {pillar.title}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground sm:text-base">
              {pillar.description}
            </p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
