---
import { business } from "../../config/business";
import { images } from "../../config/images";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  title = "Ready for a Free Quote in Your Adelaide Suburb?",
  description = "Tell NB Fixmate what needs fixing, from home repairs and renovations to rental or commercial property maintenance. Fully insured handyman support across Adelaide and surrounding areas, with no obligation to book.",
  primaryLabel = "Request a free quote",
  primaryHref = "/contact",
  imageSrc = images.imageCta.background,
  imageAlt = "",
} = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <img
    src={imageSrc}
    alt={imageAlt}
    width="1600"
    height="900"
    class="absolute inset-0 size-full object-cover"
    loading="lazy"
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-black/80"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="font-heading text-sm font-semibold tracking-tight text-primary uppercase"
      >
        Free quotes · Fully insured
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        {title}
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-light text-white/90">
        {description}
      </p>
      <div
        class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <Button
          href={primaryHref}
          openQuote={primaryHref === "/contact"}
          class="w-full sm:w-auto"
        >
          {primaryLabel}
        </Button>
        <Button
          href={business.phone.telUrl}
          variant="secondaryOnDark"
          class="w-full sm:w-auto"
          ariaLabel={`Call ${business.phone.display}`}
        >
          Call {business.phone.display}
        </Button>
      </div>
    </div>
  </Container>
</section>
