---
import { business } from "../../config/business";
import { images } from "../../config/images";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryHref?: string;
  primaryLabel?: string;
  surface?: boolean;
  imageSrc?: string;
}

const {
  eyebrow = "Get started",
  title = "Need a Handyman or Property Maintenance Quote?",
  description = "Homeowners, landlords, property managers, and businesses across Adelaide can request a free quote from NB Fixmate for repairs, renovations, and ongoing property maintenance.",
  primaryHref = "/contact",
  primaryLabel = "Request a free quote",
  surface = true,
  imageSrc = images.quoteCta.background,
} = Astro.props;
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-12 sm:py-24"]}>
  <Container>
    <div
      class="relative isolate overflow-hidden rounded-[2px] p-5 text-white sm:p-12"
    >
      <img
        src={imageSrc}
        alt=""
        width="1920"
        height="1280"
        class="absolute inset-0 size-full object-cover"
        loading="lazy"
        aria-hidden="true"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-accent/85 via-accent/55 to-accent/30 sm:bg-gradient-to-r sm:from-accent/90 sm:via-accent/50 sm:to-accent/15"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 mx-auto flex max-w-3xl flex-col items-center text-center sm:mx-0 sm:items-start sm:text-left"
      >
        <p
          class="font-heading text-sm font-semibold tracking-tight text-primary uppercase"
        >
          {eyebrow}
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {title}
        </h2>
        <p class="mt-4 max-w-2xl text-white/85">{description}</p>
        <div
          class="mt-6 flex w-full max-w-sm flex-col gap-3 sm:mt-7 sm:max-w-none sm:flex-row"
        >
          <Button
            href={primaryHref}
            openQuote={primaryHref === "/contact"}
            class="w-full sm:w-auto"
          >
            {primaryLabel}
          </Button>
          <Button
            href={business.phone.telUrl}
            variant="secondaryOnDark"
            class="w-full sm:w-auto"
          >
            Call {business.phone.display}
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
