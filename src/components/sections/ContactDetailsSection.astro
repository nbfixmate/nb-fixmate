---
import ContactMethodCard from "../cards/ContactMethodCard.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  surface?: boolean;
}

const {
  eyebrow = "Get in touch",
  title = "Contact NB Fixmate in Adelaide",
  description = "Call, email, or send a WhatsApp message to request a free quote for handyman repairs, renovations, or property maintenance.",
  surface = false,
} = Astro.props;
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-24"]}>
  <Container>
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      alignment="center"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <ContactMethodCard method="phone" />
      <ContactMethodCard method="email" />
      <ContactMethodCard method="area" />
    </div>
  </Container>
</section>
