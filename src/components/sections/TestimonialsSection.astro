---
import { getCollection } from "astro:content";
import { business } from "../../config/business";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import EmptyState from "../ui/EmptyState.astro";
import GoogleIcon from "../ui/GoogleIcon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  surface?: boolean;
  featuredOnly?: boolean;
  limit?: number;
  showGoogleCta?: boolean;
}

const {
  eyebrow = "Customer reviews",
  title = "What Adelaide Customers Say",
  description = "Real Google reviews from homeowners who booked NB Fixmate for handyman repairs, renovations, and property maintenance across Adelaide.",
  surface = false,
  featuredOnly = false,
  limit,
  showGoogleCta = true,
} = Astro.props;

const googleReviewsUrl =
  business.social.googleBusinessProfileUrl ||
  `https://www.google.com/search?q=${encodeURIComponent(`${business.name} Adelaide reviews`)}`;

let testimonials = (
  await getCollection("testimonials", ({ data }) => {
    if (!data.published) return false;
    if (featuredOnly && !data.featured) return false;
    return true;
  })
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

if (limit) {
  testimonials = testimonials.slice(0, limit);
}

function starLabel(rating: number) {
  return "★".repeat(rating) + "☆".repeat(Math.max(0, 5 - rating));
}

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("");
}
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-24"]}>
  <Container>
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      alignment="center"
    />
    {
      testimonials.length === 0 ? (
        <EmptyState
          class="mt-10"
          title="Verified feedback, shared when ready"
          description="Customer feedback will be added as verified reviews become available."
          actionLabel="Rate us on Google"
          actionHref={googleReviewsUrl}
        />
      ) : (
        <>
          <div
            class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3"
            data-reveal-stagger
          >
            {testimonials.map((testimonial) => (
              <figure class="flex h-full flex-col rounded-[2px] border border-border bg-white p-6">
                <p
                  class="text-base tracking-tight text-[#FBBC05]"
                  aria-label={`${testimonial.data.rating} out of 5 stars`}
                >
                  {starLabel(testimonial.data.rating)}
                </p>
                <blockquote class="mt-4 flex-1 text-base leading-relaxed text-muted-foreground">
                  “{testimonial.data.quote}”
                </blockquote>
                <figcaption class="mt-5 flex items-center gap-3 border-t border-border pt-4">
                  {testimonial.data.avatar ? (
                    <img
                      src={testimonial.data.avatar}
                      alt=""
                      width="48"
                      height="48"
                      class="size-12 shrink-0 rounded-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <span
                      class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-light font-heading text-sm font-bold tracking-tight text-primary"
                      aria-hidden="true"
                    >
                      {initials(testimonial.data.customerName)}
                    </span>
                  )}
                  <div class="min-w-0">
                    <p class="font-heading text-sm font-semibold tracking-tight text-accent">
                      {testimonial.data.customerName}
                    </p>
                    <p class="mt-1 inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                      <GoogleIcon class="size-3.5 shrink-0" />
                      <span>Google review</span>
                    </p>
                  </div>
                </figcaption>
              </figure>
            ))}
          </div>
          {showGoogleCta && (
            <div class="mt-10 flex justify-center">
              <Button
                href={googleReviewsUrl}
                variant="secondary"
                external
                class="gap-2.5"
              >
                <GoogleIcon class="size-5" />
                Read Google reviews
              </Button>
            </div>
          )}
        </>
      )
    }
  </Container>
</section>
