---
import { getCollection } from "astro:content";
import { serviceCategories } from "../../config/service-categories";
import ServiceCard from "../cards/ServiceCard.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  surface?: boolean;
}

const {
  eyebrow = "Full list",
  title = "Complete Handyman & Property Maintenance Services",
  description = "Browse every NB Fixmate service below. When you find the work you need, request a free quote with your Adelaide suburb and a short job description.",
  surface = false,
} = Astro.props;

const services = (await getCollection("services", ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);

const groupedCategories = serviceCategories.map((category) => ({
  ...category,
  services: category.serviceSlugs
    .map((slug) => services.find((service) => service.data.slug === slug))
    .filter((service): service is (typeof services)[number] => Boolean(service)),
}));
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-24"]}>
  <Container>
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      alignment="center"
    />
    <div class="mt-12 space-y-16">
      {
        groupedCategories.map((category) => (
          <div id={category.id} class="scroll-mt-28">
            <div class="max-w-3xl">
              <h3 class="text-2xl font-bold tracking-tight text-accent">
                {category.title}
              </h3>
              <p class="mt-2 text-muted-foreground">{category.description}</p>
            </div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {category.services.map((service) => (
                <ServiceCard {...service.data} titleAs="h4" />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

