---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface FutureItem {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  items?: FutureItem[];
  surface?: boolean;
  showCta?: boolean;
}

const {
  eyebrow = "Coming soon",
  title = "What Real Project Photos Will Include",
  description = "As authentic NB Fixmate project photography becomes available, this gallery will move from service-category examples to real completed work across Adelaide.",
  items = [
    {
      title: "Service type",
      description: "Clear labelling for the handyman or maintenance work shown.",
    },
    {
      title: "Suburb context",
      description: "Location details where appropriate, without oversharing private addresses.",
    },
    {
      title: "Factual job notes",
      description: "Short, honest descriptions of the work completed on each project.",
    },
    {
      title: "Before and after",
      description: "Authentic progress photos when they help show the result clearly.",
    },
  ],
  surface = true,
  showCta = true,
} = Astro.props;
---

<section class:list={[surface ? "bg-surface" : "bg-white", "py-16 sm:py-24"]}>
  <Container>
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      alignment="center"
      level="h2"
    />

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        items.map((item, index) => (
          <li class="flex flex-col items-center text-center sm:items-start sm:text-left">
            <span
              class="font-heading text-sm font-bold tracking-tight text-primary"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 text-lg font-bold tracking-tight text-accent">
              {item.title}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground sm:text-base">
              {item.description}
            </p>
          </li>
        ))
      }
    </ol>

    {
      showCta && (
        <div class="mt-10 flex justify-center">
          <Button href="/contact" openQuote variant="secondary">
            Request a free quote
          </Button>
        </div>
      )
    }
  </Container>
</section>
