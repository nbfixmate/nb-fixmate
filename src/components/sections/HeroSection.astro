---
import { business } from "../../config/business";
import { images } from "../../config/images";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  headingLevel?: "h1" | "h2";
}

const { headingLevel = "h1" } = Astro.props;
const Heading = headingLevel;

const proofPoints = [
  "Fully insured",
  "Free quotes",
  "Adelaide & surrounding areas",
];

const googleHref =
  business.social.googleBusinessProfileUrl ||
  `https://www.google.com/search?q=${encodeURIComponent(`${business.name} Adelaide`)}`;
---

<section data-reveal-static class="relative isolate overflow-hidden">
  <img
    src={images.hero.adelaideCity}
    alt=""
    width="1920"
    height="1280"
    class="absolute inset-0 size-full object-cover"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-black/75 sm:bg-gradient-to-r sm:from-black/85 sm:via-black/65 sm:to-black/50"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10 py-12 sm:py-24 lg:py-32">
    <div data-reveal class="mx-auto max-w-4xl text-center">
      <a
        href={googleHref}
        class="mb-3 inline-flex max-w-full flex-wrap items-center justify-center gap-1.5 py-1 font-heading text-sm font-semibold tracking-tight text-white sm:mb-4 sm:gap-2.5 sm:text-lg"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Rate us on Google"
      >
        <svg
          class="size-5 shrink-0 sm:size-8"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        <span>5.0</span>
        <span
          class="text-base tracking-tight text-[#FBBC05] sm:text-2xl"
          aria-hidden="true"
        >
          ★★★★★
        </span>
        <span class="text-white/40" aria-hidden="true">·</span>
        <span class="font-medium text-white/85">Rate us on Google</span>
      </a>
      <Heading
        class="mx-auto max-w-4xl text-3xl tracking-tight text-balance break-words text-white sm:text-5xl md:text-6xl lg:text-7xl"
      >
        Handyman & Property Maintenance in{" "}
        <span class="text-primary">Adelaide</span>
      </Heading>
      <p
        class="mx-auto mt-4 max-w-3xl text-lg font-thin text-white/90 sm:mt-5 sm:text-xl"
      >
        NB Fixmate provides fully insured handyman services, home repairs,
        renovations, painting, carpentry, and property maintenance for
        homeowners, landlords, property managers, and commercial properties
        across Adelaide and surrounding areas. Request a free quote today.
      </p>
      <ul
        class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm tracking-tight text-white/55 uppercase sm:mt-6 sm:gap-x-5 sm:text-base"
      >
        {
          proofPoints.map((label) => (
            <li class="inline-flex items-center gap-2">
              <span
                class="font-heading shrink-0 text-base font-semibold leading-none text-primary sm:text-lg"
                aria-hidden="true"
              >
                ✓
              </span>
              <span>{label}</span>
            </li>
          ))
        }
      </ul>
      <div
        class="mx-auto mt-7 flex w-full max-w-sm flex-col items-stretch gap-3 sm:mt-8 sm:max-w-none sm:flex-row sm:items-center sm:justify-center"
      >
        <Button href="/contact" openQuote class="w-full sm:w-auto">
          Request a free quote
        </Button>
        <Button
          href={business.phone.telUrl}
          variant="secondaryOnDark"
          class="w-full sm:w-auto"
          ariaLabel={`Call ${business.phone.display}`}
        >
          Call {business.phone.display}
        </Button>
      </div>
      <p class="mx-auto mt-4 max-w-[16rem] text-sm font-light text-white/60 sm:max-w-sm">
        100% free estimate · No obligation · Zero pressure to book. We'll get
        back in touch within 24 hours.
      </p>
    </div>
  </Container>
</section>
