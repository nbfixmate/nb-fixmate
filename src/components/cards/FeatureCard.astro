---
import {
  BadgeCheck,
  Building2,
  House,
  MapPin,
  MessageCircle,
  Wrench,
} from "@lucide/astro";
import IconBox from "../ui/IconBox.astro";

type FeatureCardTheme = "light" | "dark";
type FeatureIcon = "badge" | "building" | "house" | "map-pin" | "quote" | "wrench";

interface Props {
  title: string;
  description: string;
  icon?: FeatureIcon;
  theme?: FeatureCardTheme;
}

const { title, description, icon = "badge", theme = "light" } = Astro.props;
const isDark = theme === "dark";
const icons = {
  badge: BadgeCheck,
  building: Building2,
  house: House,
  "map-pin": MapPin,
  quote: MessageCircle,
  wrench: Wrench,
};
const Icon = icons[icon];
---

<article
  class:list={[
    "flex flex-col gap-4 rounded-[2px] border p-5 sm:flex-row",
    isDark ? "border-white/20 bg-white/10 text-white" : "border-border bg-white",
  ]}
>
  <IconBox variant={isDark ? "accent" : "primary"}>
    <Icon class="size-6" aria-hidden="true" />
  </IconBox>
  <div>
    <h3 class="text-lg">{title}</h3>
    <p class:list={["mt-2 text-sm", isDark ? "text-white/80" : "text-muted-foreground"]}>
      {description}
    </p>
  </div>
</article>
