---
import { getServiceIcon } from "../../config/service-icons";
import IconBox from "../ui/IconBox.astro";

type TitleTag = "h3" | "h4" | "p";

interface Props {
  title: string;
  shortDescription: string;
  icon: string;
  titleAs?: TitleTag;
}

const { title, shortDescription, icon, titleAs = "h3" } = Astro.props;

const Icon = getServiceIcon(icon);
const TitleTag = titleAs;
---

<article
  class="flex h-full flex-col rounded-[2px] border border-border bg-white p-6 transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-sm"
>
  <IconBox>
    <Icon class="size-6" aria-hidden="true" />
  </IconBox>
  <TitleTag class="mt-5 text-xl font-bold tracking-tight text-accent">
    {title}
  </TitleTag>
  <p class="mt-3 text-sm text-muted-foreground">{shortDescription}</p>
</article>
