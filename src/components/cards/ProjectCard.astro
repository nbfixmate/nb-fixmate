---
interface Props {
  href: string;
  title: string;
  shortDescription: string;
  category: string;
  location: string;
  image: string;
  imageAlt: string;
}

const { href, title, shortDescription, category, location, image, imageAlt } =
  Astro.props;
---

<a
  href={href}
  class="group block h-full overflow-hidden rounded-[2px] border border-border bg-white transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-sm"
>
  <img
    src={image}
    alt={imageAlt}
    class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    loading="lazy"
  />
  <div class="p-5 sm:p-6">
    <p class="font-heading text-sm font-semibold tracking-tight text-primary uppercase">
      {category} · {location}
    </p>
    <h2 class="mt-2 text-xl font-bold tracking-tight text-accent sm:text-2xl">
      {title}
    </h2>
    <p class="mt-3 text-sm text-muted-foreground sm:text-base">
      {shortDescription}
    </p>
    <span
      class="mt-5 inline-flex font-heading text-sm font-semibold tracking-tight text-accent uppercase transition-colors duration-200 group-hover:text-primary"
    >
      View case study
    </span>
  </div>
</a>
