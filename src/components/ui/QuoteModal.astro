---
import { X } from "@lucide/astro";
import QuoteForm from "../forms/QuoteForm.astro";
import {
  getQuoteServiceOptions,
  resolveSelectedService,
} from "../../lib/quote-form";

const serviceOptions = await getQuoteServiceOptions();
const validSelectedService = resolveSelectedService(
  serviceOptions,
  Astro.url.searchParams.get("service") ?? "",
);

const trustPoints = ["Free quotes", "Fully insured", "No obligation"];
---

<dialog
  data-quote-modal
  class="quote-modal z-[70] w-[min(calc(100%-1.25rem),36rem)] max-w-none border-0 bg-transparent p-0 shadow-none backdrop:bg-accent/65 backdrop:backdrop-blur-[2px]"
  aria-labelledby="quote-modal-title"
>
  <div
    class="quote-modal__panel relative rounded-[2px] border border-border bg-white px-6 py-7 shadow-2xl sm:px-8 sm:py-8"
  >
    <button
      type="button"
      data-quote-modal-close
      class="absolute top-4 right-4 inline-flex size-10 items-center justify-center rounded-[2px] text-muted-foreground transition-colors duration-200 hover:bg-surface hover:text-foreground sm:top-5 sm:right-5"
      aria-label="Close quote form"
    >
      <X class="size-5" aria-hidden="true" />
    </button>

    <div class="text-center">
      <p
        class="font-heading text-xs font-semibold tracking-tight text-primary uppercase sm:text-sm"
      >
        Request a free quote
      </p>
      <h2
        id="quote-modal-title"
        class="mt-1 text-xl font-bold tracking-tight text-foreground sm:text-2xl"
      >
        Tell Us What Needs Fixing
      </h2>
      <ul
        class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-muted-foreground sm:text-sm"
      >
        {
          trustPoints.map((point) => (
            <li class="inline-flex items-center gap-1.5">
              <span
                class="font-heading text-sm font-semibold leading-none text-primary"
                aria-hidden="true"
              >
                ✓
              </span>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-7">
      <QuoteForm
        serviceOptions={serviceOptions}
        selectedService={validSelectedService}
        idPrefix="modal-quote"
        submitLabel="Submit details"
        bordered={false}
        compact
      />
    </div>
  </div>
</dialog>

<style>
  .quote-modal {
    margin: auto;
    overflow: visible;
  }

  .quote-modal[open] {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .quote-modal[open] .quote-modal__panel {
      animation: quote-modal-in 180ms ease-out both;
    }
  }

  @keyframes quote-modal-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>("[data-quote-modal]");

  function closeMobileNav() {
    const trigger = document.querySelector<HTMLButtonElement>(
      "[data-mobile-nav-trigger]",
    );
    if (trigger?.getAttribute("aria-expanded") === "true") {
      trigger.click();
    }
  }

  function setWhatsAppHidden(hidden: boolean) {
    document
      .querySelector<HTMLElement>("[data-whatsapp-button]")
      ?.classList.toggle("hidden", hidden);
  }

  function openQuoteModal() {
    if (!modal || modal.open) return;
    closeMobileNav();
    modal.showModal();
    setWhatsAppHidden(true);
  }

  function closeQuoteModal() {
    if (!modal?.open) return;
    modal.close();
  }

  function handleModalClosed() {
    setWhatsAppHidden(false);
  }

  document.querySelectorAll<HTMLElement>("[data-open-quote]").forEach((trigger) => {
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      openQuoteModal();
    });
  });

  modal
    ?.querySelectorAll<HTMLElement>("[data-quote-modal-close]")
    .forEach((button) => {
      button.addEventListener("click", closeQuoteModal);
    });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeQuoteModal();
  });

  modal?.addEventListener("close", handleModalClosed);
</script>
