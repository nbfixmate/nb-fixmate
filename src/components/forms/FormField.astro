---
interface Props {
  id: string;
  label: string;
  required?: boolean;
  helpText?: string;
  error?: string;
  class?: string;
}

const {
  id,
  label,
  required = false,
  helpText,
  error,
  class: className,
} = Astro.props;
---

<div class={className}>
  <label for={id} class="font-heading text-sm font-semibold text-foreground">
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>
  <div class="mt-2">
    <slot />
  </div>
  {
    helpText && (
      <p id={`${id}-help`} class="mt-2 text-sm text-muted-foreground">
        {helpText}
      </p>
    )
  }
  {
    error && (
      <p id={`${id}-error`} class="mt-2 text-sm text-error" role="alert">
        {error}
      </p>
    )
  }
</div>
