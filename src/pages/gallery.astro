---
import AboutPreviewSection from "../components/sections/AboutPreviewSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import GalleryPreviewSection from "../components/sections/GalleryPreviewSection.astro";
import ImageCTASection from "../components/sections/ImageCTASection.astro";
import PageBannerSection from "../components/sections/PageBannerSection.astro";
import QuoteCTASection from "../components/sections/QuoteCTASection.astro";
import { images } from "../config/images";
import { site } from "../config/site";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Gallery"
  description="Browse real NB Fixmate project photos from handyman and property maintenance work across Adelaide, including kitchen renovations, flooring, fencing, landscaping, tiling, decking, sheds, and outdoor installs."
  canonical="/gallery"
  image={site.defaultOpenGraphImage}
>
  <PageBannerSection
    eyebrow="Gallery"
    title="Handyman & Property Maintenance Work in Adelaide"
    description="Real photos from completed kitchen renovations, flooring, fencing, landscaping, tiling, shed, and outdoor handyman jobs across Adelaide and surrounding areas."
    imageSrc={images.galleryPage.banner.src}
    imageAlt={images.galleryPage.banner.alt}
  />

  <AboutPreviewSection
    eyebrow="Our work"
    title="Completed Jobs Across Adelaide"
    description="This gallery features authentic photos from NB Fixmate projects, showing the practical repair, renovation, and maintenance work we deliver for local homes."
    body="From floating floors and timber finishes to fencing, kitchen renovations, garden sheds, and outdoor installs, each photo reflects work completed for Adelaide clients."
    trustPoints={[
      "Real flooring, fencing, kitchen, tiling, shed, and outdoor project photos",
      "Fully insured handyman support across Adelaide",
      "Free quotes with no obligation to book",
    ]}
    imageSrc="/images/gallery/adelaide-handyman-kitchen-renovation-before-after.jpg"
    imageAlt="Before and after comparison of an Adelaide kitchen renovation by NB Fixmate"
    imagePosition="left"
    ctaHref="/projects"
    ctaLabel="View case studies"
    showCta
  />

  <GalleryPreviewSection
    eyebrow="Recent projects"
    title="Kitchens, Flooring, Fencing & Handyman Work Across Adelaide"
    description="Browse completed job photos by service type. When you see the kind of work you need, request a free quote with your suburb and a short job description."
    showViewAll={false}
    surface
  />

  <ImageCTASection
    title="Need This Kind of Work Done at Your Property?"
    description="Request a free quote for handyman repairs, renovations, or property maintenance across Adelaide. Fully insured support for homes, rentals, and commercial properties."
    imageSrc={images.galleryPage.imageCta.src}
    imageAlt={images.galleryPage.imageCta.alt}
  />

  <FaqSection
    set="gallery"
    eyebrow="FAQs"
    title="Gallery & Services FAQs"
    description="Clear answers about the photos on this page, the services NB Fixmate offers, and how to request a free quote."
    surface={false}
    showCta
    ctaLabel="Request a free quote"
    ctaHref="/contact"
  />

  <QuoteCTASection
    title="Ready for a Free Handyman Quote?"
    description="Tell NB Fixmate what needs fixing and your Adelaide suburb. Fully insured handyman and property maintenance support, with no obligation to book."
    imageSrc={images.galleryPage.quoteCta.src}
    surface
  />
</MainLayout>
