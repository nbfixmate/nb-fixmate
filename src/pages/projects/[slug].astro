---
import { getCollection, render } from "astro:content";
import AboutPreviewSection from "../../components/sections/AboutPreviewSection.astro";
import PageBannerSection from "../../components/sections/PageBannerSection.astro";
import QuoteCTASection from "../../components/sections/QuoteCTASection.astro";
import Button from "../../components/ui/Button.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => data.published,
  );

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  shortDescription,
  category,
  location,
  featuredImage,
  imageAlt,
  seoTitle,
  seoDescription,
  eyebrow = "Project case study",
  galleryTitle = "Project Photos",
  galleryDescription = "Photos from this Adelaide handyman project, from preparation through to the finished result.",
  galleryImages,
  offerTitle = "Need Similar Work at Your Property?",
  offerDescription = "Tell NB Fixmate what you need and your Adelaide suburb. Fully insured handyman support with a free quote and no obligation to book.",
  offerBody = "From repairs and renovations to outdoor installs and property maintenance, NB Fixmate supports practical handyman work across Adelaide and surrounding areas.",
  offerPoints,
} = project.data;
---

<MainLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`/projects/${project.data.slug}`}
  image={featuredImage}
>
  <PageBannerSection
    eyebrow={eyebrow}
    title={title}
    description={shortDescription}
    imageSrc={featuredImage}
    imageAlt={imageAlt}
  />

  <section class="bg-white py-16 sm:py-24">
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16" data-reveal>
        <img
          src={galleryImages[1]?.src ?? featuredImage}
          alt={galleryImages[1]?.alt ?? imageAlt}
          width="1400"
          height="933"
          class="aspect-[16/10] w-full rounded-[2px] border border-border object-cover sm:aspect-[4/3] lg:aspect-[4/5] lg:min-h-[36rem]"
          loading="lazy"
        />
        <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
          <p class="font-heading text-sm font-semibold tracking-tight text-primary uppercase">
            {category} · {location}
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-accent sm:text-4xl">
            {title}
          </h2>
          <div
            class="prose-project mt-5 space-y-5 text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            <Content />
          </div>
          <div class="mt-8 flex w-full max-w-sm flex-col gap-3 sm:max-w-none sm:flex-row lg:justify-start">
            <Button href="/contact" openQuote class="w-full sm:w-auto">
              Request a free quote
            </Button>
            <Button href="/projects" variant="secondary" class="w-full sm:w-auto">
              All case studies
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {
    galleryImages.length > 0 && (
      <section class="bg-surface py-16 sm:py-24">
        <Container>
          <SectionHeading
            eyebrow="Project photos"
            title={galleryTitle}
            description={galleryDescription}
            alignment="center"
          />
          <div
            class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
            data-reveal-stagger
          >
            {galleryImages.map((item) => (
              <figure class="overflow-hidden rounded-[2px] border border-border bg-white">
                <img
                  src={item.src}
                  alt={item.alt}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                />
                {item.caption && (
                  <figcaption class="p-4 text-sm text-muted-foreground">
                    {item.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <AboutPreviewSection
    eyebrow="Similar work"
    title={offerTitle}
    description={offerDescription}
    body={offerBody}
    trustPoints={
      offerPoints.length > 0
        ? offerPoints
        : [
            "Fully insured handyman and renovation support",
            "Practical upgrades for Adelaide homes",
            "Free quotes with no obligation to book",
          ]
    }
    imageSrc={galleryImages[2]?.src ?? featuredImage}
    imageAlt={galleryImages[2]?.alt ?? imageAlt}
    imagePosition="right"
    ctaHref="/contact"
    ctaLabel="Request a free quote"
    showCta
    surface={false}
  />

  <QuoteCTASection
    title="Ready for a Free Quote?"
    description="Tell NB Fixmate about your job and your Adelaide suburb. Fully insured handyman and property maintenance support, with no obligation to book."
    imageSrc={featuredImage}
    surface
  />
</MainLayout>

<style>
  .prose-project :global(p + p) {
    margin-top: 1.25rem;
  }
</style>
